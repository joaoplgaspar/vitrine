# A análise só entende "qtd(p) op constante": deve gerar FALSO POSITIVO.
produto caneca = R$ 29,90;
regra a { quando qtd(caneca) * 2 >= 10 entao desconto 60% em caneca; }
regra b { quando qtd(caneca) <= 2 entao desconto 60% em caneca; }
calcular;
